# ============================================================
# GeoAsk AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# --- LLM Provider ---
# Supported: "gemini", "openai", "ollama"
LLM_PROVIDER=gemini

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional, if using OpenAI provider)
OPENAI_API_KEY=

# Ollama base URL (optional, if using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# --- Model Selection ---
# Gemini model to use for reasoning/orchestration
GEMINI_MODEL=gemini-3.6-flash

# Gemini model to use for vision tasks
GEMINI_VISION_MODEL=gemini-3.6-flash

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports

# --- GPU ---
# Set to true if CUDA GPU is available for deep learning models
USE_GPU=false
